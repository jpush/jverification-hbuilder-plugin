<template>
  <scroll-view class="page" scroll-y="true">
    <view class="card">
      <!-- #ifndef APP-ANDROID -->
      <text class="section-title">基础参数</text>
      <input class="input" v-model="appKey" placeholder="请输入 AppKey" />
      <!-- #endif -->
      <button class="button" @click="initialize">初始化</button>
      <view class="button-row">
        <button class="button half" @click="queryInitSuccess">查询初始化状态</button>
        <button class="button half button-row-second" @click="queryVerifyEnable">检查认证环境</button>
      </view>

      <text class="section-title">取号与授权</text>
      <view class="button-row">
        <button class="button half" @click="preLogin">预取号</button>
        <button class="button half button-row-second" @click="getToken">获取 token</button>
      </view>
      <button class="button" @click="clearCache">清除预取号缓存</button>
      <button class="button" @click="loginAuth">拉起授权页</button>

      <!-- #ifdef APP-ANDROID -->
      <text class="section-title">Android 授权页</text>
      <view class="button-row">
        <button class="button half" @click="configureAndroidPage">设置基础样式</button>
        <button class="button half button-row-second" @click="configureAndroidDialog">设置弹窗样式</button>
      </view>
      <button class="button" @click="configureAndroidVideo">设置背景视频</button>
      <!-- #endif -->

      <!-- #ifdef APP-IOS -->
      <text class="section-title">iOS 授权页</text>
      <view class="button-row">
        <button class="button half" @click="configureIOSPage">设置基础样式</button>
        <button class="button half button-row-second" @click="configureIOSDialog">设置弹窗样式</button>
      </view>
      <button class="button" @click="configureIOSVideo">设置背景视频</button>
      <!-- #endif -->

      <!-- #ifdef APP-HARMONY -->
      <text class="section-title">HarmonyOS 授权页</text>
      <view class="button-row">
        <button class="button half" @click="configureHarmonyBase">设置基础样式</button>
        <button class="button half button-row-second" @click="configureHarmonyDialog">设置弹窗样式</button>
      </view>
      <button class="button" @click="configureHarmonyVideo">设置背景视频</button>
      <!-- #endif -->

      <text class="section-title">接口回调结果</text>
      <text class="result">{{ lastResult }}</text>
      <text class="section-title">授权页事件</text>
      <text class="result">{{ authPageEventResult }}</text>
    </view>
  </scroll-view>
</template>

<script setup lang="uts">
import { onUnmounted, ref } from 'vue'
import {
  clearPreLoginCache,
  getToken as jverifyGetToken,
  isInitSuccess,
  checkVerifyEnable,
  loginAuth as jverifyLoginAuth,
  offAuthPageEvent,
  onAuthPageEvent,
  preLogin as jverifyPreLogin,
  setDebugMode
} from '../../uni_modules/jg-jverification'
import type {
  JVerificationInitOptions,
  JVerificationLoginAuthOptions,
  JVerificationResult
} from '../../uni_modules/jg-jverification'

// #ifdef APP-ANDROID || APP-HARMONY
import { init as jverifyInit } from '../../uni_modules/jg-jverification'
// #endif

// #ifdef APP-IOS
// iOS UTS 不允许将 init 作为命名导出；iOS 使用 initialize，参数和回调协议不变。
import { initialize as jverifyInit } from '../../uni_modules/jg-jverification'
// #endif

// #ifdef APP-ANDROID
import {
  addCustomViewsClickCallback,
  removeCustomViewsClickCallback,
  setCustomUIWithConfigAndroid
} from '../../uni_modules/jg-jverification'
// #endif

// #ifdef APP-IOS
import {
  addCustomViewsClickCallback,
  removeCustomViewsClickCallback,
  setCustomUIWithConfigiOS
} from '../../uni_modules/jg-jverification'
// #endif

// #ifdef APP-HARMONY
import {
  addCustomViewsClickCallback,
  removeCustomViewsClickCallback,
  setCustomUIWithConfigHarmony
} from '../../uni_modules/jg-jverification'
// #endif

// #ifdef APP-IOS
const appKey = ref('4fcc3e237eec4c4fb804ad49')
// #endif
// #ifdef APP-HARMONY
const appKey = ref('667c13ce8023161dbfd75a6e')
// #endif
const timeout = 10000
const lastResult = ref('SDK 调试日志已自动开启')
const authPageEventResult = ref('等待授权页事件')
// #ifdef APP-ANDROID
let selectedAndroidUIConfig: UTSJSONObject | null = null
// #endif

function trace(message: string): void {
  console.log(`[JVerification Demo] ${message}`)
}

setDebugMode(true)
trace('SDK 调试日志已自动开启')

// 注册型回调在页面生命周期内只注册一次；插件端使用 @UTSJS.keepAlive
// 保证同一授权页内多次点击自定义控件都能回调。
// #ifdef APP-ANDROID
addCustomViewsClickCallback((id: string): void => {
  lastResult.value = `Android 自定义控件点击 | id=${id}`
  trace(`回调：${lastResult.value}`)
})
// #endif

onUnmounted((): void => {
  offAuthPageEvent()
  // #ifdef APP-ANDROID || APP-IOS || APP-HARMONY
  removeCustomViewsClickCallback()
  // #endif
  trace('页面销毁：认证事件与自定义控件回调已注销')
})

// #ifdef APP-IOS
addCustomViewsClickCallback((id: string): void => {
  lastResult.value = `iOS 自定义控件点击 | id=${id}`
  trace(`回调：${lastResult.value}`)
})
// #endif

// #ifdef APP-HARMONY
addCustomViewsClickCallback((id: string): void => {
  lastResult.value = `HarmonyOS 自定义控件点击 | id=${id}`
  trace(`回调：${lastResult.value}`)
})
// #endif

function resultText(action: string, response: JVerificationResult): string {
  let content = action
  if (response.code != null) content += ` | code=${response.code}`
  if (response.content != null) content += ` | content=${response.content}`
  if (response.operator != null) content += ` | operator=${response.operator}`
  if (response.enable != null) content += ` | enable=${response.enable}`
  if (response.uuid != null) content += ` | uuid=${response.uuid}`
  if (response.msg != null) content += ` | msg=${response.msg}`
  return content
}

function display(action: string, response: JVerificationResult): void {
  const content = resultText(action, response)
  lastResult.value = content
  trace(`回调：${content}`)
}

function displayAuthPageEvent(event: JVerificationResult): void {
  const content = resultText('authPageEvent', event)
  authPageEventResult.value = content
  trace(`事件：${content}`)
}

function handleAuthPageEvent(event: JVerificationResult): void {
  displayAuthPageEvent(event)
}

// HBuilderX Android 代理会把 loginAuth 的第三个参数生成为必填；
// Demo 使用独立订阅展示授权页事件，因此显式传入空兼容回调，避免同一事件重复展示。
function ignoreLegacyAuthPageEvent(_event: JVerificationResult): void {}

// 授权页事件使用独立订阅接口，避免 loginAuth 的兼容事件回调承担订阅职责。
// 页面销毁时会显式注销；重复注册会替换已有监听器。
onAuthPageEvent(handleAuthPageEvent)

function initialize(): void {
  trace('点击：初始化')
  const options: JVerificationInitOptions = {
    channel: 'developer-default',
    timeout: timeout,
    isProduction: false
  }
  // #ifndef APP-ANDROID
  options.appKey = appKey.value
  // #endif
  jverifyInit(options, (response: JVerificationResult): void => {
    display('init', response)
  })
}

function queryInitSuccess(): void {
  trace('点击：查询初始化状态')
  isInitSuccess((response: JVerificationResult): void => {
    display('isInitSuccess', response)
  })
}

function queryVerifyEnable(): void {
  trace('点击：检查认证环境')
  checkVerifyEnable((response: JVerificationResult): void => {
    display('checkVerifyEnable', response)
  })
}

function preLogin(): void {
  trace('点击：预取号')
  jverifyPreLogin(timeout, (response: JVerificationResult): void => {
    display('preLogin', response)
  })
}

function getToken(): void {
  trace('点击：获取 token')
  jverifyGetToken(timeout, (response: JVerificationResult): void => {
    display('getToken', response)
  })
}

function clearCache(): void {
  trace('点击：清除预取号缓存')
  clearPreLoginCache()
  lastResult.value = 'clearPreLoginCache 已调用'
  trace(`结果：${lastResult.value}`)
}

function loginAuth(): void {
  trace('点击：拉起授权页')
  lastResult.value = '等待 loginAuth 回调'
  authPageEventResult.value = '等待授权页事件'
  // #ifdef APP-ANDROID
  const androidUIConfig = selectedAndroidUIConfig
  if (androidUIConfig != null) {
    // Android 官方 Demo 在每次 loginAuth 前重新设置 UI；SDK 会按授权页生命周期释放配置。
    setCustomUIWithConfigAndroid(androidUIConfig)
    trace('Android 授权页样式已在 loginAuth 前应用')
  }
  // #endif
  const options: JVerificationLoginAuthOptions = {
    autoFinish: true,
    timeout: timeout,
    animationFlag: true
  }
  jverifyLoginAuth(options, (response: JVerificationResult): void => {
    display('loginAuth', response)
  }, ignoreLegacyAuthPageEvent)
}

// #ifdef APP-ANDROID
function configureAndroidPage(): void {
  trace('点击：Android 设置基础样式')
  const config: UTSJSONObject = {
    setAppLanguageType: 0,
    setNavTransparent: true,
    setNavText: '',
    setNavReturnBtnHidden: false,
    setLogBtnText: '极光认证测试',
    setLogBtnTextBold: true,
    setNumberTextBold: true,
    setSloganTextBold: true,
    setVirtualButtonColor: 0xff000000,
    setPrivacyState: false,
    setPrivacyNameAndUrlBeanList: [{
      name: '条款1',
      url: 'https://www.jiguang.cn/about',
      beforeName: ',',
      afterName: ','
    }, {
      name: '条款2',
      url: 'https://www.jiguang.cn/about',
      beforeName: '',
      afterName: ''
    }, {
      name: '条款3',
      url: 'https://www.jiguang.cn/about',
      beforeName: ',',
      afterName: ','
    }],
    setAppPrivacyColor: [0xff4169e1, 0xffff6347],
    setLogoImgPathFromJs: 'static/jverification/weixin.png',
    setLogBtnImgPathFromJs: 'static/jverification/login.png',
    setAuthBGImgPathFromJs: 'static/jverification/bg.jpeg',
    setPrivacyNavReturnBtnPathFromJs: 'static/jverification/weixin.png',
    setCheckedImgPathFromJs: 'static/jverification/selected.png',
    setUncheckedImgPathFromJs: 'static/jverification/unselected.png',
    setPrivacyTextSize: 12,
    setPrivacyTextBold: false,
    setPrivacyUnderlineText: false,
    setPrivacyTextWidth: 280,
    setPrivacyCheckboxSize: 14,
    setPrivacyCheckboxMargin: [0, 0, 0, 0],
    enableHintToast: true,
    enableHintToastText: '请先同意隐私协议',
    setLoadingViewEnable: true,
    setStatusBarTransparent: true,
    setPrivacyCheckDialogConfig: {
      enablePrivacyCheckDialog: true,
      setPrivacyCheckDialogTitleText: '测试标题',
      setPrivacyCheckDialogTitleTextSize: 18,
      setPrivacyCheckDialogTitleTextBold: true,
      setPrivacyCheckDialogTitleTextColor: 0xff4169e1,
      setPrivacyCheckDialogContentTextGravity: 'left',
      setPrivacyCheckDialogContentTextSize: 16,
      setPrivacyCheckDialogContentTextPaddingL: 20,
      setPrivacyCheckDialogContentTextPaddingT: 8,
      setPrivacyCheckDialogContentTextPaddingR: 20,
      setPrivacyCheckDialogContentTextPaddingB: 8,
      setPrivacyCheckDialogLogBtnImgPath: 'static/jverification/login.png',
      setPrivacyCheckDialogLogBtnText: '同意并登录',
      setPrivacyCheckDialogLogBtnTextColor: 0xffff6347,
      setPrivacyCheckDialogLogBtnMarginT: 12,
      setPrivacyCheckDialogLogBtnMarginR: 20,
      setPrivacyCheckDialogLogBtnMarginB: 16,
      setPrivacyCheckDialogGravity: 'center',
      setPrivacyCheckDialogLogBtnWidth: 120,
      setPrivacyCheckDialogLogBtnHeight: 44,
      setPrivacyCheckDialogWidth: 300,
      setPrivacyCheckDialogHeight: 240,
      setPrivacyCheckDialogBackgroundColor: 0xffffffff,
      addCustomViews: [{
        type: 'button',
        id: 'android-privacy-cancel',
        text: '取消',
        textSize: 15,
        textColor: 0xff475569,
        backgroundColor: 0xffe5e7eb,
        width: 120,
        height: 44,
        margins: [20, 12, 0, 16],
        belowPrivacyText: true
      }]
    },
    addCustomViews: [{
      type: 'text',
      id: 'android-demo-text',
      finishFlag: false,
      width: 100,
      height: 50,
      text: '自定义文本',
      textSize: 20,
      align: 15,
      margins: [100, 100, 0, 0],
      textAlignment: 4,
      textViewGravity: 2,
      bgColor: 0xff7b68ee
    }, {
      type: 'image',
      id: 'android-demo-image',
      finishFlag: true,
      width: 50,
      height: 50,
      align: 13,
      margins: [0, 0, 0, 0],
      bgImgPath: 'static/jverification/qq.png'
    }]
  }
  selectedAndroidUIConfig = config
  lastResult.value = 'Android 基础授权页样式已选择，将在拉起授权页前应用'
}

function configureAndroidVideo(): void {
  trace('点击：Android 设置背景视频')
  const config: UTSJSONObject = {
    setNavColor: 0xff000000,
    setNavText: '一键登录',
    setLogBtnText: '本机号码一键登录',
    setLogBtnTextBold: true,
    setNumberColor: 0xffffffff,
    setSloganTextColor: 0xffffffff,
    setPrivacyState: false,
    setAppPrivacyColor: [0xffffffff, 0xff60a5fa],
    setAuthBGVideoPathFromJs: 'static/jverification/videobg.mp4',
    setAuthBGVideoPlaceholderPathFromJs: 'static/jverification/bg.jpeg',
    setAuthBGVideoScaleType: 2,
    enableHintToast: true,
    enableHintToastText: '请先同意隐私协议'
  }
  selectedAndroidUIConfig = config
  lastResult.value = 'Android 背景视频样式已选择，将在拉起授权页前应用'
}

