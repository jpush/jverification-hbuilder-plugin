function configureIOSVideo(): void {
  trace('点击：iOS 设置背景视频')
  setCustomUIWithConfigiOS({
    shouldAutorotate: true,
    supportedInterfaceOrientations: 30,
    navColor: 0xff000000,
    navReturnImg: 'static/jverification/windowClose.png',
    agreementNavReturnImage: 'static/jverification/windowClose.png',
    logoImg: 'static/jverification/logo.png',
    preferredStatusBarStyle: 1,
    logBtnText: '本机号码一键登录',
    logBtnFont: { size: 16, weight: 'semibold' },
    numberColor: 0xffffffff,
    sloganTextColor: 0xffffffff,
