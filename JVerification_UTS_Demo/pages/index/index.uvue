      textColor: 0xffffffff,
      width: 44,
      height: 44,
      isFinish: false
    },
    preferredStatusBarStyle: 1,
    agreementPreferredStatusBarStyle: 1,
    navReturnImageEdgeInsets: { top: 4, left: 4, bottom: 4, right: 4 },
    agreementNavReturnImage: 'static/jverification/windowClose.png',
