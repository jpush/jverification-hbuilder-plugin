}

.section-title {
  margin-top: 24px;
  font-size: 17px;
  font-weight: 600;
  color: #17233d;
}

.input {
  height: 42px;
  margin-top: 12px;
  padding: 0 12px;
  border-width: 1px;
  border-color: #d9e1ec;
  border-radius: 6px;
}

.button-row {
  display: flex;
  flex-direction: row;
}

.button {
  margin-top: 12px;
  background-color: #2563eb;
  color: #ffffff;
}

.half {
  flex: 1;
}

.button-row-second {
  margin-left: 8px;
}

.secondary {
  background-color: #475569;
}

.result {
  margin-top: 12px;
  padding: 12px;
  border-radius: 6px;
  background-color: #f1f5f9;
